# =============================================================================
# Enterprise Knowledge Assistant — Environment Configuration
# -----------------------------------------------------------------------------
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# Every service reads from this single file via docker-compose.
# =============================================================================

# ---------- General ----------
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO                     # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                     # true in prod for structured logs

# ---------- Backend / API ----------
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Comma-separated list of allowed CORS origins for the browser client.
BACKEND_CORS_ORIGINS=http://localhost:3000
# Secret used to sign internal tokens / verify webhooks. Generate a long random value.
SECRET_KEY=change-me-to-a-long-random-string

# ---------- PostgreSQL (source of truth) ----------
POSTGRES_USER=eka
POSTGRES_PASSWORD=eka_password
POSTGRES_DB=eka
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Full async DSN used by SQLAlchemy. Host is the compose service name.
DATABASE_URL=postgresql+asyncpg://eka:eka_password@postgres:5432/eka

# ---------- Redis (cache + queue + sessions) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/0

# ---------- Qdrant (vector index) ----------
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=                    # empty for local; set in prod
QDRANT_COLLECTION=eka_chunks

# ---------- Object storage (MinIO / S3) ----------
S3_ENDPOINT_URL=http://minio:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=eka-documents
S3_USE_SSL=false

# ---------- Authentication (Clerk) ----------
# Provider is pluggable; "clerk" is the default concrete implementation.
# Use AUTH_PROVIDER=dev for local development with no Clerk account. Dev tokens
# look like:  dev:<email>[:<org_slug>[:<role>]]  e.g. dev:alice@acme.com:acme:owner
AUTH_PROVIDER=clerk                # clerk | authjs | dev
CLERK_SECRET_KEY=sk_test_xxx
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_JWKS_URL=https://your-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_ISSUER=                      # optional: verify JWT `iss` claim (e.g. https://your-instance.clerk.accounts.dev)
CLERK_WEBHOOK_SECRET=whsec_xxx

# ---------- AI providers ----------
# LLM + embeddings are pluggable; "openai" is the default implementation.
LLM_PROVIDER=openai
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=sk-xxx
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536                 # must match the model + Qdrant collection

# ---------- Frontend (Next.js) ----------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
